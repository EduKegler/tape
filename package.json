{
  "name": "tape",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "node scripts/check-packages.mjs && tsc -p packages/core && tsc -p packages/venues && tsc -p packages/trade && tsc --noEmit",
    "fixtures": "node scripts/record-fixtures.mjs 8",
    "verify": "pnpm typecheck && eslint && prettier --check . && vitest run",
    "prepare": "lefthook install"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/brygada-1918": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.23",
    "@tanstack/redact": "^0.2.3",
    "@tanstack/store": "^0.11.2",
    "@tape/core": "workspace:*",
    "@tape/trade": "workspace:*",
    "@tape/venues": "workspace:*",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "lightweight-charts": "^5.2.1",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "uqr": "^0.1.3",
    "viem": "^2.57.13",
    "wagmi": "^3.7.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@tanstack/cli": "^0.72.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/intent": "^0.5.6",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.2",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.64.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
